    legal:{verdict:"خوب",badge:"🟢",tip:"«حَتَّىٰ يَتَبَيَّنَ لَكُمُ الْخَيْطُ الْأَبْيَضُ مِنَ الْخَيْطِ الْأَسْوَدِ» یعنی حق از باطل جدا می‌شود. آیه تأیید می‌کند که حقیقت در این پرونده آشکار خواهد شد و حق با تو آشکار می‌گردد.",warning:"اقدام عجولانه بدون آمادگی. آیه می‌فرماید: «أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ» یعنی کار را کامل و تا انتها انجام بده. پرونده را کامل آماده کن و نیمه‌کاره وارد دادگاه نشو.",action:"اقدام کن، اما: ۱) وکیل متخصص بگیر، ۲) مدارک را کامل جمع کن، ۳) صبر کن تا حقیقت آشکار شود، ۴) صدقه بده و دعای حق‌طلبی بخوان."},
    loan:{verdict:"خوب",badge:"🟢",tip:"«وَكُلُوا وَاشْرَبُوا» یعنی بهره‌مندی از رزق حلال، مجاز است. این وام، اگر حلال باشد، مصداق بهره‌مندی از رزق الهی است و گره‌گشا خواهد بود.",warning:"گرفتن وام ربوی یا بدون برنامه‌ی بازپرداخت. آیه می‌فرماید: «تِلْكَ حُدُودُ اللَّهِ فَلَا تَقْرَبُوهَا» یعنی ربا، از حدود الهی است. همچنین «أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ» یعنی اقساط را تا انتها کامل پرداخت کن.",action:"اقدام کن، اما: ۱) از مسیر حلال (قرض‌الحسنه یا وام بانکی شرعی) بگیر، ۲) جدول اقساط دقیق بنویس، ۳) مطمئن شو قسط بیش از ۳۰٪ درآمدت نیست، ۴) به تعهدات بازپرداخت تا انتها وفا کن، ۵) صدقه بده."},
    home:{verdict:"خوب",badge:"🟢",tip:"«هُنَّ لِبَاسٌ لَّكُمْ وَأَنتُمْ لِبَاسٌ لَّهُنَّ» یعنی پوشش و سرپناه. خانه، مصداق «لباس» و سرپناه خانواده است. آیه تأیید می‌کند که این معامله‌ی مسکن، با رعایت موازین شرعی، مبارک و آرامش‌بخش است.",warning:"معامله بدون رعایت موازین شرعی یا بدون استعلام. آیه می‌فرماید: «حَتَّىٰ يَتَبَيَّنَ لَكُمُ الْخَيْطُ الْأَبْيَضُ» یعنی قبل از معامله، همه‌چیز را شفاف کن (سند، قیمت، وضعیت ملک).",action:"اقدام کن، اما: ۱) استعلام ثبتی کامل بگیر، ۲) بازدید فنی انجام بده، ۳) قرارداد رسمی بنویس، ۴) منصف باش، ۵) صدقه بده."},
    car:{verdict:"خوب",badge:"🟢",tip:"«وَكُلُوا وَاشْرَبُوا» یعنی بهره‌مندی از نعمت‌های حلال. خرید خودرو، مصداق بهره‌مندی از نعمت الهی است. آیه تأیید می‌کند که این خرید، با رعایت موازین شرعی، مبارک است.",warning:"خرید بدون کارشناسی یا با فریب. آیه می‌فرماید: «حَتَّىٰ يَتَبَيَّنَ لَكُمُ الْخَيْطُ الْأَبْيَضُ» یعنی صبر کن تا وضعیت واقعی خودرو مشخص شود.",action:"اقدام کن، اما: ۱) کارشناسی فنی کامل بگیر، ۲) استعلام سند و خلافی بزن، ۳) بیمه فعال کن، ۴) منصف باش، ۵) صدقه بده."},
    guarantee:{verdict:"میانه",badge:"🟠",tip:"«هُنَّ لِبَاسٌ لَّكُمْ وَأَنتُمْ لِبَاسٌ لَّهُنَّ» یعنی پوشش و حمایت متقابل. اگر ضمانت تو، پوشش و حمایت واقعی از کسی است که نیاز دارد، آیه تأیید می‌کند. اما باید با عقل و احتیاط باشد.",warning:"ضمانت بدون توان مالی یا بدون شناخت کافی. آیه می‌فرماید: «تِلْكَ حُدُودُ اللَّهِ فَلَا تَقْرَبُوهَا» یعنی در ضمانت هم حدود عقل و توان رعایت شود.",action:"اگر ضمانت می‌کنی: ۱) فقط مبلغی که توان پرداختش را داری، ۲) قرارداد مکتوب بنویس، ۳) از طرف مقابل تضمین متقابل بگیر، ۴) صدقه بده."},
    travel:{verdict:"خوب",badge:"🟢",tip:"«وَابْتَغُوا مَا كَتَبَ اللَّهُ لَكُمْ» یعنی آنچه خدا برایت نوشته را بجوی. سفر، مصداق جستجوی خیر الهی است. آیه تأیید می‌کند که این سفر، با رعایت موازین شرعی، مبارک و پربار است.",warning:"سفر بدون برنامه یا بدون رعایت موازین شرعی. آیه می‌فرماید: «تِلْكَ حُدُودُ اللَّهِ فَلَا تَقْرَبُوهَا» یعنی در سفر هم حدود الهی رعایت شود. همچنین «أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ» یعنی برنامه‌ی سفر را کامل اجرا کن.",action:"اقدام کن. اما: ۱) برنامه‌ی دقیق داشته باش، ۲) بیمه بگیر، ۳) صدقه‌ی سفر بده، ۴) دعای سفر بخوان، ۵) موازین شرعی را رعایت کن."},
    migration:{verdict:"میانه رو به خوب",badge:"🟠",tip:"«وَابْتَغُوا مَا كَتَبَ اللَّهُ لَكُمْ» یعنی آنچه خدا برایت نوشته را بجوی. اگر مهاجرت، مسیر جستجوی خیر الهی است، آیه تأیید می‌کند. «فَالْآنَ بَاشِرُوهُنَّ» یعنی الان وقت اقدام است، اما با برنامه.",warning:"مهاجرت بدون آمادگی کامل یا بدون رعایت موازین شرعی. آیه می‌فرماید: «حَتَّىٰ يَتَبَيَّنَ لَكُمُ الْخَيْطُ الْأَبْيَضُ» یعنی صبر کن تا شرایط کاملاً روشن شود (ویزا، مدارک، مقصد).",action:"اقدام کن، اما: ۱) آمادگی کامل (زبان، مدارک، سرمایه)، ۲) تحقیق درباره‌ی مقصد، ۳) شبکه‌ی ارتباطی بساز، ۴) موازین شرعی را رعایت کن، ۵) صدقه بده و توکل کن."},
    moving:{verdict:"خوب",badge:"🟢",tip:"«هُنَّ لِبَاسٌ لَّكُمْ وَأَنتُمْ لِبَاسٌ لَّهُنَّ» یعنی سرپناه و آرامش. جابجایی به خانه‌ی جدید، مصداق یافتن «لباس» و سرپناه جدید است. آیه تأیید می‌کند که این جابجایی، مبارک است.",warning:"جابجایی عجولانه بدون برنامه. آیه می‌فرماید: «أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ» یعنی کار را کامل و تا انتها انجام بده. تسویه‌حساب کامل محل قبلی و برنامه‌ریزی دقیق لازم است.",action:"اقدام کن، اما: ۱) لیست وسایل بنویس، ۲) تسویه‌حساب کامل محل قبلی را انجام بده، ۳) مقصد را حضوری ببین، ۴) صدقه بده و دعای ورود به خانه‌ی جدید بخوان."},
    study:{verdict:"خوب",badge:"🟢",tip:"«كَذَٰلِكَ يُبَيِّنُ اللَّهُ آيَاتِهِ لِلنَّاسِ لَعَلَّهُمْ يَتَّقُونَ» یعنی خدا آیاتش را بیان می‌کند تا مردم بفهمند و تقوا پیشه کنند. آیه تأیید می‌کند که مسیر تحصیل، مصداق «بیان آیات» و فهم است و با تحصیل، حق از باطل برایت روشن می‌شود.",warning:"مطالعه بدون برنامه یا تقلب. آیه می‌فرماید: «أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ» یعنی کار را کامل و تا انتها انجام بده. مطالعه را نیمه‌کاره رها نکن و با صداقت کامل درس بخوان.",action:"اقدام کن و ادامه بده. اما: ۱) برنامه‌ی مشخص بنویس، ۲) با صداقت و تلاش واقعی درس بخوان، ۳) صبور باش و تا انتها ادامه بده، ۴) صدقه بده و «رَبِّ زِدْنِي عِلْمًا» بخوان، ۵) نماز را فراموش نکن."},
    health:{verdict:"خوب",badge:"🟢",tip:"«فَتَابَ عَلَيْكُمْ وَعَفَا عَنكُمْ» یعنی خدا عفو کرد و بخشید. آیه تأیید می‌کند که شفا و سلامتی، با توبه، صدقه، و توکل بر خدا، در راه است. «وَكُلُوا وَاشْرَبُوا» یعنی تغذیه‌ی سالم و مناسب، بخش مهمی از شفاست.",warning:"بی‌توجهی به علائم یا قطع خودسرانه‌ی درمان. آیه می‌فرماید: «أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ» یعنی درمان را کامل و تا انتها ادامه بده. اگر درمان را نیمه‌کاره رها کنی، مشکل برمی‌گردد.",action:"اقدام کن. ۱) به پزشک متخصص مراجعه کن، ۲) درمان را تا انتها کامل کن، ۳) تغذیه‌ی سالم و مناسب داشته باش، ۴) صدقه بده و دعای شفا بخوان، ۵) نماز و توکل بر خدا را فراموش نکن."}
